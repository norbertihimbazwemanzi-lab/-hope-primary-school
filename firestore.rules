rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users & User Attributes (Cross-device user profiles & attributes stored in Firestore)
    match /users/{userId} {
      allow read, write: if true;
    }

    // School Settings & Branding (Public read/write so all devices see the school logo & data)
    match /school_settings/{settingId} {
      allow read, write: if true;
    }

    // School Photo Gallery (Public read/write so photos are visible across all user devices)
    match /school_gallery/{itemId} {
      allow read, write: if true;
    }

    // School Registration Documents (Public read/write so all applicants see required forms and downloads)
    match /school_documents/{docId} {
      allow read, write: if true;
    }

    // School Announcements (Public read/write for active notices and banners across all devices)
    match /school_announcements/{announcementId} {
      allow read, write: if true;
    }

    // Student Progress Logs (Accessible across staff devices)
    match /student_progress_logs/{logId} {
      allow read, write: if true;
    }

    // Enrolled Students Roster (Synced across devices)
    match /enrolled_students/{studentId} {
      allow read, write: if true;
    }

    // Staff Members & Role Mappings (Cross-device staff authentication & enrollment sync)
    match /staff_members/{staffId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Payment & Accounting Transactions (Ledger records)
    match /payment_transactions/{txId} {
      allow read, write: if true;
    }

    // Admissions Applications & Registrations
    match /admissions_applications/{appId} {
      allow read, write: if true;
    }

    // Applicant & Parent Chat Messages
    match /applicant_chats/{chatId} {
      allow read, write: if true;
    }

    // Student Attendance Records
    match /attendance_records/{attId} {
      allow read, write: if true;
    }

    // Teacher & Staff Duty Attendance Records
    match /teacher_attendance_records/{tAttId} {
      allow read, write: if true;
    }

    // Student Discipline & Conduct Records
    match /discipline_records/{discId} {
      allow read, write: if true;
    }

    // Visitor Contact Inquiries
    match /visitor_inquiries/{inqId} {
      allow read, write: if true;
    }

    // Campus Tour Bookings
    match /campus_tour_bookings/{tourId} {
      allow read, write: if true;
    }
  }
}

